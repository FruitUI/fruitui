{
  "name": "fruitui/fruitui",
  "description": "CSS-first, Apple-inspired UI components for Laravel.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0 || ^12.0 || ^13.0",
    "illuminate/view": "^11.0 || ^12.0 || ^13.0"
  },
  "suggest": {
    "livewire/livewire": "Use the optional, session-backed Mail preferences example."
  },
  "require-dev": {
    "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
    "livewire/livewire": "^3.0 || ^4.0",
    "phpunit/phpunit": "^11.0 || ^12.0"
  },
  "autoload": { "psr-4": { "FruitUI\\": "src/Laravel/" } },
  "autoload-dev": { "psr-4": { "FruitUI\\Tests\\": "tests/php/" } },
  "extra": { "laravel": { "providers": ["FruitUI\\FruitUIServiceProvider"] } },
  "scripts": { "test": "phpunit" },
  "config": { "sort-packages": true }
}
